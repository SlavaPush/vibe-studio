# Переопределения .env для офиса на VPS. Скопировать в /home/office/office/vps.env.
# Unit office-api.service читает сначала /home/office/office/.env, затем этот файл: значения отсюда заменяют значения из .env.
# Ключи и пароли сюда не записывать: они остаются в .env.

# Сборка панели (npm run build в apps/office/web): API раздаёт её на том же адресе.
OFFICE_WEB_DIST_DIR=/home/office/vibe-studio/apps/office/web/dist

# Адрес офиса за Caddy. Запросы с другим Host (например, по IP) получают 403 forbidden_origin.
OFFICE_ALLOWED_HOSTS=vibe-studio.twc1.net
OFFICE_ALLOWED_ORIGINS=https://vibe-studio.twc1.net

# Публичный репозиторий клонируется по HTTPS без ключей; push ветки задачи выполняется токеном GitHub App.
TARGET_REPO_URL=https://github.com/SlavaPush/vibe-studio.git
GITHUB_APP_PRIVATE_KEY_PATH=/home/office/office/vibe-office.private-key.pem

# Состояние офиса на диске VPS: office.sqlite и office.checkpoints.sqlite в одном каталоге.
OFFICE_DATABASE_URL=sqlite:////home/office/office/office.sqlite
WORKSPACE_DIR=/home/office/office/workspace
OFFICE_ARTIFACTS_DIR=/home/office/office/artifacts
