# Скопировать в .env (файл .env не попадает в Git). Значения ключей не записывать в документацию.

# Провайдеры облачных моделей для профилей cloud и hybrid. Anthropic — основной, OpenAI — резервный и модерация.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Локальные модели (профиль local и локальные шаги профиля hybrid).
OLLAMA_URL=http://127.0.0.1:11434

# Таймаут одного обращения роли к модели в секундах. Пусто — 300 для облачных провайдеров и 600 для Ollama.
OFFICE_MODEL_TIMEOUT_SECONDS=

# Предел времени выполнения задачи в минутах от перехода в developing; ожидание подтверждения требований не входит. Пусто — 60.
OFFICE_TASK_TIME_LIMIT_MINUTES=

# Состояние офиса. Локально — SQLite, при деплое — строка подключения PostgreSQL.
OFFICE_DATABASE_URL=sqlite:///./office.sqlite

# Репозиторий, которым управляет офис (без него API не запускается), и каталог рабочей области (в .gitignore). Пусто — ../workspace относительно api/.
TARGET_REPO_URL=git@github.com:SlavaPush/vibe-studio.git
WORKSPACE_DIR=

# Образ sandbox и число одновременно работающих контейнеров проверок. Пусто — back-office-sandbox:p4 и 2.
OFFICE_SANDBOX_IMAGE=
OFFICE_SANDBOX_CONTAINERS=

# GitHub App офиса: ID приложения, ID установки в репозитории и путь к файлу закрытого ключа *.pem вне репозитория.
# По ключу офис получает короткоживущий токен установки для push ветки задачи и PR. Sandbox и роли токен не получают.
# Без любой из трёх переменных исполнитель выпуска не запускается: задачи ждут в awaiting_integration, API работает.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# Репозиторий для push и PR. Пусто — SlavaPush/vibe-studio.
OFFICE_GITHUB_REPO=

# Интервал опроса исполнителя выпуска в секундах (пусто — 20), предел ожидания обязательных проверок PR
# и предел сверки операции с неустановленным исходом в минутах (пусто — 30).
OFFICE_RELEASE_POLL_SECONDS=
OFFICE_CHECKS_TIMEOUT_MINUTES=
OFFICE_RECONCILE_TIMEOUT_MINUTES=

# Предел обращений агента ревью PR на задачу сверх бюджета графа (пусто — 2).
OFFICE_PR_REVIEW_CALLS=

# Сколько раз задача, чьё слияние отменено revert после отката или непрошедших проверок итогового commit,
# возвращается на доработку (пусто — 1; 0 — без доработки).
OFFICE_REWORK_LIMIT=

# Публичный сервис vibe-chat: GET /api/version, /healthz и главная страница (основание выпуска и проверка после деплоя).
# Пусто — https://elbrus-vibe-chat.onrender.com.
OFFICE_SERVICE_URL=

# Доступ к Render для деплоя и отката; sandbox его не получает. Без ключа и id сервиса очередь выпуска не запускается.
RENDER_API_KEY=
RENDER_SERVICE_ID=

# Окно проверки после деплоя и повторов чтения версии сервиса в секундах (пусто — 120). OFFICE_VERIFY_FAULT=1 — управляемый сбой проверки
# выпуска задачи (origin = task) для ручной проверки отката; проверка кандидатов исправления всегда реальная. В остальное время оставить пустым.
OFFICE_VERIFY_SECONDS=
OFFICE_VERIFY_FAULT=

# Ожидание деплоя Render вне офиса перед стартом выпуска в минутах (пусто — 30).
OFFICE_EXTERNAL_DEPLOY_WAIT_MINUTES=

# Логины GitHub, чьи прямые push в main и слияния PR допускаются в состав выпуска, через запятую (пусто — SlavaPush),
# и slug GitHub App офиса для проверки слияний офиса (пусто — vibe-office).
OFFICE_TRUSTED_GITHUB_LOGINS=
OFFICE_GITHUB_APP_SLUG=

# Логин GitHub владельца: PR серверного контура сливается только после его одобрения (APPROVED) для текущего head.
# Пусто — SlavaPush.
OFFICE_OWNER_LOGIN=

# Реестр личных кодов участников — таблица access_codes чата (Supabase). Строка подключения session pooler:
# та же, что DATABASE_URL_SUPABASE чата, или строка отдельной роли office_codes (README, раздел «Вход по личному коду»).
# Офис читает и меняет только таблицу access_codes. Пусто — вход в офис невозможен (503 codes_unavailable).
OFFICE_CODES_DATABASE_URL=

# Разрешённые значения заголовков Host и Origin через запятую. Пусто — адреса API 127.0.0.1:8001 и localhost:8001 и dev-сервера панели на порту 5173.
OFFICE_ALLOWED_HOSTS=
OFFICE_ALLOWED_ORIGINS=

# Каталог артефактов задач (в .gitignore). Пусто — ../artifacts относительно api/.
OFFICE_ARTIFACTS_DIR=

# Адрес API Anthropic для офиса. Пусто — https://api.anthropic.com.
OFFICE_ANTHROPIC_BASE_URL=
