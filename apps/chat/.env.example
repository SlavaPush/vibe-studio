# Скопировать в .env (файл .env не попадает в Git). Значения ключей записывать только в .env.

# Провайдеры моделей. Anthropic — основной, OpenAI — резервный, а также модерация и изображения.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Адрес API Anthropic. Сервер читает его только из этого файла, а не из окружения оболочки.
ANTHROPIC_BASE_URL=https://api.anthropic.com

# PostgreSQL. Локально — контейнер из docker-compose. На Render в DATABASE_URL подставляется строка Supabase
# (session pooler, порт 5432, параметр sslmode=require); локально она хранится в DATABASE_URL_SUPABASE для проверок.
DATABASE_URL=postgresql://vibe:vibe@127.0.0.1:5432/vibe
DATABASE_URL_SUPABASE=

# Приватное хранилище изображений (Supabase Storage). Backend использует только секретный ключ (sb_secret_...).
# Publishable-ключ браузеру не выдаётся, Supabase Auth не используется.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=images

# Версия сборки. Если не задана, берутся первые 7 символов RENDER_GIT_COMMIT (Render задаёт его при деплое), иначе dev.
APP_VERSION=dev

# Каталог сборки интерфейса (web/dist). Если задан, API раздаёт интерфейс сам; в образе Docker задан.
# Локально не задаётся: интерфейс раздаёт Vite.
WEB_DIST_DIR=

# Код демодоступа, который получают участники. Пустой код запрещает вход.
DEMO_ACCESS_CODE=

# Адреса интерфейса, с которых разрешены изменяющие запросы (заголовок Origin), через запятую.
# Если переменная не задана, а RENDER_EXTERNAL_URL задан (Render), разрешён только адрес сервиса.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Флаг Secure у cookie сеанса. Для Safari на http://localhost — false.
COOKIE_SECURE=true
# Секрет для HMAC адреса клиента в учёте лимитов (случайная строка).
QUOTA_SALT=
# Брать адрес клиента из X-Forwarded-For (только за доверенным прокси, например Render).
TRUST_PROXY_HEADERS=false
# Число доверенных прокси перед сервером: берётся элемент X-Forwarded-For с этим номером с конца (целое, не меньше 1).
PROXY_HOPS=1
# Качество генерации изображений: low, medium, high.
IMAGE_QUALITY=medium

# Лимиты за скользящие 24 часа: пользователь, источник запросов (адрес клиента), весь сервис.
USER_RUNS_PER_DAY=60
USER_IMAGES_PER_DAY=5
USER_TOKENS_PER_DAY=1000000
SOURCE_RUNS_PER_DAY=300
SOURCE_IMAGES_PER_DAY=25
SOURCE_TOKENS_PER_DAY=5000000
SERVICE_RUNS_PER_DAY=1500
SERVICE_IMAGES_PER_DAY=100
SERVICE_TOKENS_PER_DAY=20000000
# Новые гостевые сеансы в час с одного адреса.
SESSIONS_PER_HOUR=20
