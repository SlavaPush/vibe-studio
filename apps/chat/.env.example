# Скопировать в .env (файл .env не попадает в Git). Значения ключей не записывать в документацию.

# Провайдеры моделей. Anthropic — основной, OpenAI — резервный, а также модерация и изображения.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# PostgreSQL. Локально — контейнер из docker-compose, на Render — строка подключения Supabase (session pooler).
DATABASE_URL=postgresql://vibe:vibe@127.0.0.1:5432/vibe

# Приватное хранилище изображений (Supabase Storage). Заполняется на этапе P3.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=images

# Версия сборки. На Render задаётся из commit SHA.
APP_VERSION=dev

# Код демодоступа, который получают участники.
DEMO_ACCESS_CODE=
